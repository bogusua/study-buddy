# ---- Налаштування для перевірки віддаленого репозиторію ----
#
# Скопіюй цей файл як .env і заповни значення:
#   cp .env.example .env
#
# ВАЖЛИВО: .env містить секрети -- НІКОЛИ не комітити його в Git!

# GitHub Personal Access Token (read-only)
#
# Як отримати:
#   1. GitHub → Settings → Developer settings → Personal access tokens
#   2. Обери "Fine-grained tokens" → "Generate new token"
#   3. Token name: "python-course-checker"
#   4. Expiration: 90 days (можна подовжити пізніше)
#   5. Repository access: "Only select repositories" → обери свій python-course
#   6. Permissions → Repository permissions:
#      - Contents: Read-only
#      - Metadata: Read-only (ставиться автоматично)
#      Більше НІЧОГО не вмикай!
#   7. Generate token → скопіюй токен (він показується тільки один раз)
#
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Репозиторій у форматі username/repo-name
GITHUB_REPO=username/python-course
